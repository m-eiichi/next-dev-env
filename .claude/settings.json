{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-changed-file.mjs\"",
            "timeout": 60,
            "statusMessage": "ESLint で確認しています"
          }
        ]
      }
    ]
  }
}
